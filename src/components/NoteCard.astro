---
import type { CollectionEntry } from "astro:content";

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);

const preview = (note.data.description ?? note.body ?? "")
  .replace(/^---[\s\S]*?---/, "")
  .replace(/!\[[^\]]*\]\([^)]+\)/g, "")
  .replace(/\[[^\]]+\]\([^)]+\)/g, "$1")
  .replace(/[`*_>#-]/g, " ")
  .replace(/\s+/g, " ")
  .trim();
---

<article class="flex h-full flex-col rounded-xl border border-black/[0.06] bg-background p-4 transition-colors hover:border-black/[0.1] dark:border-white/[0.07] dark:bg-background dark:hover:border-white/[0.12]">
  <div class="flex items-start justify-between gap-3">
    <h2 class="text-base font-semibold leading-snug sm:text-lg">{note.data.title}</h2>
    {
      note.data.pubDatetime && (
        <time
          class="shrink-0 pt-0.5 text-xs tracking-[0.14em] text-black/42 uppercase dark:text-white/42"
          datetime={note.data.pubDatetime.toISOString()}
        >
          {formatDate(note.data.pubDatetime)}
        </time>
      )
    }
  </div>

  <p class="mt-2.5 line-clamp-4 text-sm leading-6 text-black/62 dark:text-white/62">
    {preview}
  </p>
</article>
